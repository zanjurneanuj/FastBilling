rules_version = '2';

// Fast Billing — Firestore security rules.
//
// IMPORTANT: this file is not deployed automatically. Copy it into
// Firebase Console → Firestore Database → Rules (or run
// `firebase deploy --only firestore:rules` if you have the Firebase CLI
// set up for this project), after reviewing it against whatever rules are
// currently live — this was written from the collections the app code
// actually uses, but it replaces the whole ruleset rather than merging
// with it, so double-check nothing else depends on rules not covered here
// before deploying.
//
// Schema covered (see lib/ for where each collection is written):
//   users/{uid}                        — profile stub (name/email), written on sign-in
//   users/{uid}/invoices/{id}          — one user's invoices
//   users/{uid}/clients/{id}           — one user's clients
//   users/{uid}/catalog/{id}           — one user's product catalog
//   users/{uid}/devices/{id}           — login/device history
//   business_profiles/{uid}            — editable business profile (name, GST, logo, bank, PDF template)
//   subscriptions/{uid}                — free-tier/premium status (see lib/services/SubscriptionService.dart)
//   payments/{id}                      — Razorpay checkout ledger (see lib/services/PaymentService.dart)
//   referralCodes/{code}               — refer & earn code → owner uid (see lib/services/ReferralService.dart)
//   referrals/{newUserUid}             — who referred whom; referrer bonus is counted from these
//
// Admin access (the web panel in admin/) is granted by email allowlist —
// keep ADMIN_EMAILS here in sync with admin/app.js's ADMIN_EMAILS.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email in [
          'zanjurneanuj@gmail.com'
        ];
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);
      allow read: if isAdmin();

      match /invoices/{invoiceId} {
        allow read, write: if isOwner(uid);
        allow read: if isAdmin();
      }
      match /clients/{clientId} {
        allow read, write: if isOwner(uid);
        allow read: if isAdmin();
      }
      match /catalog/{productId} {
        allow read, write: if isOwner(uid);
        allow read: if isAdmin();
      }
      match /devices/{deviceId} {
        allow read, write: if isOwner(uid);
        allow read: if isAdmin();
      }
    }

    match /business_profiles/{uid} {
      allow read, write: if isOwner(uid);
      allow read: if isAdmin();
    }

    // Owner can write their own subscription doc too — that's how the
    // client-side Razorpay demo flow marks itself premium on payment
    // success (see PaymentService.dart's doc comment: this is fine for a
    // demo/soft launch, but a real production billing setup should verify
    // payments server-side via a webhook instead of trusting the client).
    match /subscriptions/{uid} {
      allow read, write: if isOwner(uid);
      allow read, write: if isAdmin();
    }

    // Ledger of every Razorpay checkout outcome (success / failed /
    // cancelled / activation_failed) — see PaymentService. Append-only:
    // users can add their own entries and read them back, never edit or
    // delete; admins can read everything.
    match /payments/{paymentId} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status in
             ['success', 'failed', 'cancelled', 'activation_failed'];
      allow read: if request.auth != null
        && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // Refer & earn (see ReferralService).
    // referralCodes/{CODE} → owner uid. Fetched by exact code only (no
    // listing, so codes can't be enumerated); claimed once, never changed.
    match /referralCodes/{code} {
      allow get: if request.auth != null;
      allow list: if isAdmin();
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && code.size() == 6;
    }

    // referrals/{newUserUid}: written once by the new user. The code must
    // exist, must belong to the stated referrer, and can't be their own.
    // The referrer reads (counts) the docs naming them to get their bonus.
    match /referrals/{refereeUid} {
      allow create: if request.auth != null
        && request.auth.uid == refereeUid
        && request.resource.data.refereeUid == refereeUid
        && request.resource.data.referrerUid != refereeUid
        && exists(/databases/$(database)/documents/referralCodes/$(request.resource.data.code))
        && get(/databases/$(database)/documents/referralCodes/$(request.resource.data.code)).data.uid
             == request.resource.data.referrerUid;
      allow read: if request.auth != null
        && (request.auth.uid == refereeUid
            || resource.data.referrerUid == request.auth.uid
            || isAdmin());
    }
  }
}
